# NetBird Product Lab: environment variables
# Copy to .env.local for local development. Every variable is OPTIONAL;
# the app works with none of them set. Never commit real values.

# Optional, server-side only (deliberately NOT prefixed with NEXT_PUBLIC_, so it
# can never reach the browser). A token only raises GitHub's rate limit for
# unauthenticated requests (60/hour per IP) to 5,000/hour. Use a fine-grained
# token with read-only access to public repositories and no extra permissions.
# The app only ever sends GET requests.
GITHUB_TOKEN=

# Optional. Set to 1 to skip GitHub entirely and serve the bundled sample
# snapshot (useful for demos, screenshots, and offline development).
USE_SAMPLE_DATA=0
